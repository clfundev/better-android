<?xml version="1.0" encoding="utf-8"?>
<io.github.clfundev.better.widget.RoundCornerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginHorizontal="15dp"
    android:layout_marginBottom="10dp"
    app:roundCorner="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_rvfocusplan_sub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/appElevatedCardColor"
        android:paddingHorizontal="15dp">

        <TextView
            android:id="@+id/tv_rvfocusplan_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textSize="18sp"
            app:layout_constraintBottom_toTopOf="@+id/guideline_rvfocusplan"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_rvfocusplan_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="@+id/tv_rvfocusplan_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_rvfocusplan_title" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_rvfocusplan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <TextView
            android:id="@+id/tv_rvfocusplan_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toEndOf="@+id/tv_rvfocusplan_time"
            app:layout_constraintTop_toTopOf="@+id/tv_rvfocusplan_time" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</io.github.clfundev.better.widget.RoundCornerFrameLayout>
