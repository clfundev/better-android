<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/tv_rvbackupitem_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_rvbackupitem_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp" />

    <io.github.clfundev.better.widget.DownloadButton
        android:id="@+id/downloadbtn_rvbackupitem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:background="@drawable/btn_text_r100"
        android:gravity="center"
        android:paddingVertical="5dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textSize="16sp"
        app:borderWidth="1dp"
        app:finishedTextColor="?attr/colorOnPrimary"
        app:primaryColor="?attr/colorPrimary"
        app:progressColor="@color/primary_light_a30"
        app:roundCorner="100dp"
        app:textOnFinished="@string/itembackup_btn_restore"
        app:textOnIdle="@string/itembackup_btn_download"
        app:unfinishedTextColor="?attr/colorPrimary" />

</LinearLayout>
