<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_focus"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginEnd="24dp"
        android:background="?attr/appBackgroundColor"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="@string/focus_title"
        app:titleMarginStart="24dp"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <TextView
        android:id="@+id/tv_focus_plan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_text_r8"
        android:drawablePadding="2dp"
        android:padding="4dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textSize="17sp"
        app:drawableStartCompat="@drawable/ic_baseline_keyboard_arrow_down_20"
        app:drawableTint="?attr/colorControlNormal"
        app:layout_constraintBottom_toTopOf="@+id/tv_focus_time"
        app:layout_constraintEnd_toEndOf="@+id/cpv_focus"
        app:layout_constraintStart_toStartOf="@+id/cpv_focus"
        app:layout_constraintTop_toTopOf="@+id/cpv_focus" />

    <io.github.clfundev.better.widget.CircularProgressView
        android:id="@+id/cpv_focus"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline3"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_focus" />

    <TextView
        android:id="@+id/tv_focus_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_text_r8"
        android:letterSpacing="0.016"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        android:textSize="44sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/cpv_focus"
        app:layout_constraintStart_toStartOf="@+id/cpv_focus"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_focus" />

    <TextView
        android:id="@+id/tv_focus_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        app:layout_constraintEnd_toEndOf="@+id/cpv_focus"
        app:layout_constraintStart_toStartOf="@+id/cpv_focus"
        app:layout_constraintTop_toBottomOf="@+id/tv_focus_time" />

    <TextView
        android:id="@+id/tv_focus_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:paddingHorizontal="60dp"
        android:paddingVertical="12dp"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline3"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_focus" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>