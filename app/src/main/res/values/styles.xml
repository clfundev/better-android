<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DefaultWheelPicker">
        <item name="itemTextColor">?android:attr/textColorPrimary</item>
        <item name="selectedItemTextColor">?attr/colorPrimary</item>
        <item name="unitTextColor">?attr/colorPrimary</item>
        <item name="selectedItemDividerColor">@color/gray</item>
        <item name="itemTextSize">14sp</item>
        <item name="selectedItemTextSize">18sp</item>
        <item name="unitTextSize">16sp</item>
        <item name="selectedItemTextStrokeWidth">0.8</item>
        <item name="selectedItemLetterSpacing">0.008</item>
        <item name="itemHeightSpace">16dp</item>
        <item name="itemWidthSpace">32dp</item>
    </style>

    <style name="DefaultLineChartView">
        <item name="lineWidth">2dp</item>
        <item name="lineColor">?attr/colorPrimary</item>
        <item name="bgLineWidth">1px</item>
        <item name="bgLineColor">@color/gray</item>
        <item name="bgNumTextSize">10sp</item>
        <item name="bgNumTextColor">@color/gray</item>
        <item name="bgDateTextSize">10sp</item>
        <item name="bgDateTextColor">@color/gray</item>
        <item name="detailLineWidth">1px</item>
        <item name="detailLineColor">@color/gray</item>
        <item name="detailPointStrokeWidth">1dp</item>
        <item name="detailPointStrokeColor">?attr/colorPrimary</item>
        <item name="detailPointFillColor">@color/white</item>
        <item name="detailTextSize">14sp</item>
        <item name="detailTextColor">?android:attr/textColorPrimary</item>
        <item name="detailRectColor">?attr/appElevatedCardColor</item>
        <item name="detailRectShadowColor">?attr/appElevatedCardShadowColor</item>
        <item name="detailRectShadowRadius">2dp</item>
        <item name="bgLineCount">5</item>
        <item name="bgLineNumGap">14dp</item>
        <item name="bgLineDateGap">14dp</item>
        <item name="detailPointRadius">5dp</item>
        <item name="detailDateNumGap">2dp</item>
        <item name="detailLineRectGap">7dp</item>
        <item name="detailRectPadding">5dp</item>
        <item name="detailRectRoundCorner">5dp</item>
    </style>

    <style name="RruleWheelPicker" parent="DefaultWheelPicker">
        <item name="halfDisplayCount">1</item>
        <item name="itemTextSize">16sp</item>
        <item name="selectedItemTextSize">20sp</item>
        <item name="itemHeightSpace">10dp</item>
        <item name="selectAfterScroll">true</item>
        <item name="showSelectedItemDivider">false</item>
    </style>

    <style name="DefaultCircularCheckBox">
        <item name="textSize">14sp</item>
        <item name="arcWidth">0.5dp</item>
        <item name="arcColor">?android:attr/textColorSecondary</item>
        <item name="checkedFillColor">?attr/colorPrimary</item>
        <item name="checkedTextColor">?attr/colorOnPrimary</item>
        <item name="uncheckedTextColor">?android:attr/textColorSecondary</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="DefaultCircularProgressView">
        <item name="bgArcColor">@color/gray_a40</item>
        <item name="fgArcColor">?attr/colorPrimary</item>
        <item name="bgArcWidth">6dp</item>
        <item name="fgArcWidth">6dp</item>
    </style>

    <style name="NoAnimDialog" parent="Theme.Better">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <style name="SlideBottomAnimDialog" parent="NoAnimDialog">
        <item name="android:windowAnimationStyle">@style/Animation_DialogSlideBottom</item>
    </style>

    <style name="FadeAnimDialog" parent="NoAnimDialog">
        <item name="android:windowAnimationStyle">@style/Animation_DialogFade</item>
    </style>

    <style name="Animation_DialogSlideBottom" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <style name="Animation_DialogFade" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="Animation_ImmersiveFocusActivity" parent="android:Animation.Activity">
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_bottom</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
    </style>

    <style name="TextAppearance.Better.DialogButton" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.008</item>
    </style>

</resources>